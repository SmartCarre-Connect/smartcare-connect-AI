# Frontend environment settings

# CRITICAL FOR PRODUCTION: Set this to your Render backend URL
# Format: https://your-backend.onrender.com/api/v1
# The frontend will use this in production (Vercel) to call the backend API
VITE_API_URL=https://smartcare-connect-api.onrender.com/api/v1

# Frontend demo toggle: set to true to restrict app to demo-only login and offline demo behavior
# Use VITE_RESTRICT_TO_DEMO=true for presentation mode
VITE_RESTRICT_TO_DEMO=false

# Base URL for the frontend (usually "/" for root)
VITE_BASE_URL=/ 

# Optional intro video URLs for first-time users
VITE_INTRO_VIDEO_URL_EN=https://your-cdn.com/intro-en.mp4
VITE_INTRO_VIDEO_URL_HI=https://your-cdn.com/intro-hi.mp4
VITE_INTRO_VIDEO_URL_MR=https://your-cdn.com/intro-mr.mp4
# Or a single fallback URL
VITE_INTRO_VIDEO_URL=https://your-cdn.com/intro-default.mp4

