# Copy this file to .env and set values in your hosting provider's secret manager.
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/<database>
DATABASE_NAME=smartcare_connect
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=20971520

# SMTP / Email settings (leave blank to use development fallback)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=no-reply@yourdomain.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

CORS_ORIGINS=http://localhost:5173,https://smartcare-connect-ai.vercel.app
