# Copy this file to .env and set values in your hosting provider's secret manager.

# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/smartcare_connect

# Database Name
DATABASE_NAME=smartcare_connect

# JWT Secret Key (CRITICAL: Use a long, random, secure string in production)
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-characters

# Gemini AI API Key (optional, for AI features)
GEMINI_API_KEY=

# HeyGen API Key (optional, for avatar video generation)
HEYGEN_API_KEY=sk_V2_hgu_kpcryR8l5LR_p7zRwEADPn6UwU1XtzzKNWvJiusBQvJR
HEYGEN_API_URL=https://api.heygen.com

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# SMTP / Email settings (leave blank to use development fallback - prints OTP to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@smartcareconnect.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Upload directories
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=20971520

# Emergency contact number
EMERGENCY_NUMBER=102

# CORS: Allowed frontend origins (comma-separated)
# Include your Vercel frontend URL in production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://smartcare-connect-ai.vercel.app

